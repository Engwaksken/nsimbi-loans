DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
SITE_URL=https://example.com
JWT_SECRET=
JWT_EXPIRE=86400

# Encrypts AI provider API keys (System > AI Settings). Long random value; do not change once keys are saved.
APP_KEY=

# Lets cPanel cron jobs run through a web address (cron/<job>.php?key=...).
# At least 16 random characters; see Admin > System > Cron Jobs.
CRON_KEY=
